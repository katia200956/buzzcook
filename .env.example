# Copy this file to .env.local (it stays on this Mac, git ignores it) and fill in your
# Open Food Facts login: the user name (not the e-mail) and the password from openfoodfacts.org.
# Then restart the dev server. Without these, typed-in products are only saved on the phone.
EXPO_PUBLIC_OFF_USER=
EXPO_PUBLIC_OFF_PASSWORD=

# Supabase (Project Settings → API Keys / Data API): the Project URL and the publishable (anon) key.
# Never put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
