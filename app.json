{
  "expo": {
    "name": "Buzzcook",
    "slug": "buzzcook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-image",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Buzzcook використовує камеру, щоб сканувати штрихкоди продуктів для щоденника калорій.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Buzzcook відкриває фото чека або страви, щоб додати продукти в холодильник чи порахувати калорії.",
          "cameraPermission": "Buzzcook використовує камеру, щоб сфотографувати чек або страву."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E8"
        }
      ]
    ],
    "scheme": "buzzcook",
    "experiments": {
      "typedRoutes": true
    }
  }
}
